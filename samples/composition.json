{
  "description": "Przykładowa kompozycja jako lista operacji sceny (jak w narzędziu MCP apply_scene_ops). Pole graphicId wskazuje nazwę pliku z samples/; loadSamples zamienia ją na id grafiki w bibliotece.",
  "name": "Wieś latem",
  "width": 1600,
  "height": 900,
  "ops": [
    { "op": "set_canvas", "background": "#cfe6f3" },
    { "op": "add_shape", "shape": "rect", "layer": "Tło", "x": 0, "y": 620, "width": 1600, "height": 280, "fill": "#9cc77a", "name": "Łąka" },
    { "op": "insert_graphic", "graphicId": "gora.svg", "layer": "Tło", "x": 1050, "y": 330, "width": 500 },
    { "op": "insert_graphic", "graphicId": "slonce.svg", "layer": "Tło", "x": 1300, "y": 50, "width": 220 },
    { "op": "insert_graphic", "graphicId": "chmura.svg", "layer": "Tło", "x": 180, "y": 160, "width": 300, "as": "chmura" },
    { "op": "duplicate", "nodes": ["$chmura"], "dx": 520, "dy": -60 },
    { "op": "insert_graphic", "graphicId": "swierk.svg", "layer": "Obiekty", "x": 1080, "y": 420, "width": 200 },
    { "op": "insert_graphic", "graphicId": "dom.svg", "layer": "Obiekty", "x": 300, "y": 260, "width": 420, "as": "dom" },
    { "op": "insert_graphic", "graphicId": "drzewo.svg", "layer": "Obiekty", "x": 720, "y": 300, "width": 330, "rotation": -4, "as": "drzewo" },
    { "op": "insert_graphic", "graphicId": "plot.svg", "layer": "Obiekty", "x": 200, "y": 520, "width": 400, "as": "plot" },
    { "op": "group", "nodes": ["$dom", "$drzewo", "$plot"], "name": "Zagroda" },
    { "op": "insert_graphic", "graphicId": "kot.svg", "layer": "Obiekty", "x": 660, "y": 650, "width": 150 },
    { "op": "insert_graphic", "graphicId": "krzew.svg", "layer": "Obiekty", "x": 820, "y": 600, "width": 220 },
    { "op": "add_text", "text": "Wieś latem", "layer": "Teksty", "x": 80, "y": 60, "fontSize": 110, "fontFamily": "DejaVu Serif" }
  ]
}
